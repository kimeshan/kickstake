# Base URL of the API (server-side calls + dev proxy target)
NEXT_PUBLIC_API_URL=http://localhost:3801

# Public base URL of this web app — used to build shareable join links
# (e.g. https://kickstake.app/j/abc123). Prod: https://kickstake.app
NEXT_PUBLIC_APP_URL=http://localhost:3800

# Public base URL of the activity challenge (its own subdomain in prod). Drives
# the exact-host rewrite of "/" to /challenges and challenge page metadata.
# Build-time: must also be passed as a Docker build arg. Locally, leave it
# unset (defaults to the prod host, so localhost keeps the football home) and
# open http://localhost:3800/challenges directly.
# Prod: https://challenge.kickstake.app
# NEXT_PUBLIC_CHALLENGE_APP_URL=
