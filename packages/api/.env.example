# Local Postgres (docker-compose maps container 5432 → host 5437)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/kickstake

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3801

# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3800

# Google SSO (optional locally). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and add this authorized
# redirect URI:  http://localhost:3801/auth/callback/google
# Email-code sign-in works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=3801
