# ─── Database ──────────────────────────────────────────────────────────────
# Local Postgres (docker-compose maps container 5432 → host 5437)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/kickstake

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars
# This API's own base URL (used for OAuth callbacks, etc.)
BETTER_AUTH_URL=http://localhost:3801
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3800
# Only for deployed envs where API + web share a parent domain — scopes the
# session cookie across subdomains (e.g. .kickstake.app). Leave BLANK locally.
COOKIE_DOMAIN=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public web app URL — used for links in emails. Prod: https://kickstake.app
APP_URL=http://localhost:3800

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Emails the sign-in codes. Leave RESEND_API_KEY blank locally and the code is
# logged to the API console instead. Get a key at https://resend.com.
# EMAIL_FROM must use a Resend-verified domain (kickstake.app) in production.
# For a quick test before verifying, use: KickStake <onboarding@resend.dev>
# (resend.dev only delivers to the Resend account owner's address).
RESEND_API_KEY=
EMAIL_FROM=KickStake <hello@kickstake.app>

# ─── Google SSO (optional locally) ───────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3801/auth/callback/google
# Email-code sign-in works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3801
